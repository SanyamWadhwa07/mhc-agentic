# LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_QUALITY_MODEL=llama-3.3-70b-versatile
QUALITY_RESPONSE_MODEL=openai/gpt-oss-120b

# RAG
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CONFIDENCE_THRESHOLD=0.6

# Pipeline
REACT_MAX_STEPS=4
MEMORY_SUMMARY_INTERVAL=10
RATE_LIMIT_PER_MINUTE=10
EMOTIONAL_INTENSITY_THRESHOLD=0.8

# Safety
CRISIS_KEYWORDS_PATH=./app/safety/crisis_keywords.json
SEMANTIC_SAFETY_THRESHOLD=0.82

# Response quality
RESPONSE_MIN_LENGTH=80

# Database
DATABASE_URL=sqlite+aiosqlite:///./mhc.db
REDIS_URL=redis://localhost:6379

# Debug
DEBUG_MODE=false
LOG_LEVEL=INFO
