# LLM — use these exact models (8b-instant is too weak for mental health)
GROQ_API_KEY=your_groq_api_key_here
GROQ_FAST_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_QUALITY_MODEL=llama-3.3-70b-versatile
QUALITY_RESPONSE_MODEL=openai/gpt-oss-120b

# RAG
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CONFIDENCE_THRESHOLD=0.6

# Pipeline
REACT_MAX_STEPS=4
MEMORY_SUMMARY_INTERVAL=10
RATE_LIMIT_PER_MINUTE=10

# Mode routing thresholds
EMOTIONAL_INTENSITY_THRESHOLD=0.5
RL_MIN_FEEDBACK_TURNS=5
RL_EMOTION_OVERRIDE_THRESHOLD=0.6

# Safety
CRISIS_KEYWORDS_PATH=./app/safety/crisis_keywords.json
SEMANTIC_SAFETY_THRESHOLD=0.82

# Response quality
RESPONSE_MIN_LENGTH=80

# Assessment (PHQ-9 / GAD-7)
ASSESSMENT_ENABLED=true
ASSESSMENT_MIN_SEVERITY=mild
ASSESSMENT_EMA_ALPHA_START=0.4
ASSESSMENT_EMA_ALPHA_FLOOR=0.1

# Journaling
JOURNAL_CONTEXT_TURNS=3

# Database
DATABASE_URL=sqlite+aiosqlite:///./mhc.db
REDIS_URL=redis://localhost:6379

# Debug
DEBUG_MODE=false
LOG_LEVEL=INFO
